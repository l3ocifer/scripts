def main():
    """Main function for token creation."""
    print_banner()
    
    # Parse arguments
    if len(sys.argv) != 3:
        print("Usage: token <TOKEN_SYMBOL> <DOMAIN_NAME>")
        print("Example: token MOON moon.finance")
        sys.exit(1)
    
    token_symbol = sys.argv[1].upper()
    domain_name = sys.argv[2].lower()
    token_name = input(f"Enter full token name (default: {token_symbol} Token): ").strip() or f"{token_symbol} Token"
    
    print(f"Creating token: {token_name} ({token_symbol})")
    print(f"Domain: {domain_name}")
    print()
    
    # Check requirements and credentials
    check_requirements()
    check_credentials()
    
    # Update template
    update_template()
    
    # Create repository name
    repo_name = create_repo_name(token_symbol, domain_name)
    
    # Create GitHub repository
    create_github_repo(repo_name)
    
    # Set up project
    project_dir = setup_project(repo_name, token_symbol, domain_name, token_name)
    
    # Create admin wallet
    wallet_address = create_admin_wallet(project_dir)
    
    # Deploy project
    if deploy_project(project_dir):
        display_results(repo_name, domain_name, wallet_address, project_dir)
    else:
        print("❌ Deployment failed. Check the logs above for details.")
        sys.exit(1)

if __name__ == "__main__":
    main()
